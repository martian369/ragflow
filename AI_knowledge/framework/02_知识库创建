## 🏗️ 后端逻辑流程

### 5. **API路由层** (`/api/apps/kb_app.py`)
```python
@manager.route('/create', methods=['post'])
@login_required
@validate_request("name")
def create():
    req = request.json
    dataset_name = req["name"]
    
    # 1. 参数验证
    if not isinstance(dataset_name, str):
        return get_data_error_result(message="Dataset name must be string.")
    if dataset_name.strip() == "":
        return get_data_error_result(message="Dataset name can't be empty.")
    if len(dataset_name.encode("utf-8")) > DATASET_NAME_LIMIT:
        return get_data_error_result(
            message=f"Dataset name length is {len(dataset_name)} which is larger than {DATASET_NAME_LIMIT}")

    # 2. 名称处理和去重
    dataset_name = dataset_name.strip()
    dataset_name = duplicate_name(
        KnowledgebaseService.query,
        name=dataset_name,
        tenant_id=current_user.id,
        status=StatusEnum.VALID.value)
    
    try:
        # 3. 数据准备
        req["id"] = get_uuid()                    # 生成唯一ID
        req["name"] = dataset_name                # 清理后的名称
        req["tenant_id"] = current_user.id        # 租户ID
        req["created_by"] = current_user.id       # 创建者ID
        
        # 4. 获取租户配置信息
        e, t = TenantService.get_by_id(current_user.id)
        if not e:
            return get_data_error_result(message="Tenant not found.")
        req["embd_id"] = t.embd_id                 # 嵌入模型ID

        # 5. 数据库保存
        if not KnowledgebaseService.save(**req):
            return get_data_error_result()
            
        return get_json_result(data={"kb_id": req["id"]})
    except Exception as e:
        return server_error_response(e)
```

